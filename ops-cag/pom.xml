<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.satsim</groupId>
    <artifactId>satsim-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>ops-cag</artifactId>
  <name>SatSim Command Authorization Gate (Category B configuration item)</name>
  <description>Deterministic, dependency-free authorization gate on the telecommand path
    (ADR-0007, SCR-010, SDP §1.1). JDK + pus-core only: no Spring, no MCP protocol types,
    no network access. Decodes every telecommand, classifies it by content, and decides
    forward / reject / hold-for-confirmation.</description>
  <dependencies>
    <!-- The only compile dependency: the packet library, for decoding the octets
         the gate authorizes (ADR-0007 C2). No third-party dependency is added. -->
    <dependency>
      <groupId>org.satsim</groupId>
      <artifactId>pus-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.satsim</groupId>
      <artifactId>sim-test-support</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>

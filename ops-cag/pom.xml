<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.satsim</groupId>
    <artifactId>satsim-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>ops-cag</artifactId>
  <name>SatSim Command Authorization Gate (Category B configuration item)</name>
  <description>Deterministic, dependency-free authorization gate on the telecommand path
    (ADR-0007, SCR-010, SDP §1.1). JDK + pus-core only: no Spring, no MCP protocol types,
    no network access. Decodes every telecommand, classifies it by content, and decides
    forward / reject / hold-for-confirmation.</description>
  <dependencies>
    <!-- The only compile dependency: the packet library, for decoding the octets
         the gate authorizes (ADR-0007 C2). No third-party dependency is added. -->
    <dependency>
      <groupId>org.satsim</groupId>
      <artifactId>pus-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.satsim</groupId>
      <artifactId>sim-test-support</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Category B coverage gate [SIM-REQ-QA-004, SIM-TC-060]: 100 % statement
           and decision coverage on this CI, enforced in the build rather than
           merely reported (SDP §2.1, ADR-0007 C7). JaCoCo branch coverage is the
           decision-coverage proxy. Configuration only — the plugin is already
           registered in the parent's pluginManagement and in the SRF. -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>test</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
          <execution>
            <id>check-category-b-coverage</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <!-- The recorded baseline of the safety analysis §8, acting
                         as a no-regression ratchet [SIM-REQ-QA-004, SCR-012].
                         100 % of *reachable* code is covered; the residue is 23
                         instructions and 1 branch in four regions that are
                         unreachable by construction, each itemized and
                         justified there. JaCoCo cannot exclude a line range, so
                         a literal 1.00 would require excluding whole classes —
                         which for CommandAuthorizationGate would gut the very
                         measurement this bar exists to make. Completeness of
                         the itemization is enforced separately by SIM-TC-060,
                         so uncovered code nobody justified fails the build. -->
                    <limit>
                      <counter>INSTRUCTION</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.968</minimum>
                    </limit>
                    <limit>
                      <counter>BRANCH</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.982</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
